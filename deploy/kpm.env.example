# Environment for the Kali Pentest MCP service.
# Copy to `kpm.env` (same directory) and adjust; the systemd units load it
# via `EnvironmentFile=` when present.

# --- CVE intelligence (optional) --------------------------------------------
# NVD API key for CVSS lookups (raises the rate limit):
#   https://nvd.nist.gov/developers/request-an-api-key
# NVD_API_KEY=

# Allow a few anonymous NVD lookups when no key is set (1 = yes).
# KPM_NVD_ANON=0

# --- Runner limits (optional) -----------------------------------------------
# Hard ceiling per external command, seconds.
# PENTEST_CMD_TIMEOUT=900
# Commands/minute throttle for the subprocess runner.
# PENTEST_RATE_PER_MIN=10

# --- Scope override (optional) ----------------------------------------------
# Defaults to <project>/scope.yaml.
# KPM_SCOPE_FILE=/home/AIuser/kali-pentest-mcp/bugbounty/kali-pentest-mcp/scope.yaml
